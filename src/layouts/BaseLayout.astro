---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { canonicalFor, SITE_DESCRIPTION, SITE_NAME } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  canonicalPath?: string;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = `${SITE_NAME} Can one AI coding prompt replace your SaaS?`,
  description = SITE_DESCRIPTION,
  image = "/og/home.png",
  canonicalPath = Astro.url.pathname,
  jsonLd = []
} = Astro.props;
const canonical = canonicalFor(Astro.url, canonicalPath);
const imageUrl = new URL(image, canonical).toString();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="theme-color"
      content="#070907"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#f3efe4"
      media="(prefers-color-scheme: light)"
    />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <script is:inline>
      try {
        const stored = localStorage.getItem("vibecode-theme");
        document.documentElement.dataset.theme = stored === "light" ? "light" : "dark";
      } catch {}
    </script>
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
    />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="noise" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="toast" id="toast" role="status" aria-live="polite"></div>
    <script is:inline>
      const root = document.documentElement;
      const themeButton = document.querySelector("[data-theme-toggle]");
      const syncThemeLabel = () => {
        const light = root.dataset.theme === "light";
        if (themeButton) {
          themeButton.setAttribute("aria-label", light ? "Switch to dark mode" : "Switch to light mode");
          themeButton.querySelector("[data-theme-word]").textContent = light ? "CRT" : "PAPER";
        }
      };
      syncThemeLabel();
      themeButton?.addEventListener("click", () => {
        const next = root.dataset.theme === "light" ? "dark" : "light";
        root.dataset.theme = next;
        try { localStorage.setItem("vibecode-theme", next); } catch {}
        syncThemeLabel();
      });

      const toast = document.querySelector("#toast");
      window.vibeToast = (message) => {
        if (!toast) return;
        toast.textContent = message;
        toast.classList.add("is-visible");
        clearTimeout(window.vibeToastTimer);
        window.vibeToastTimer = setTimeout(() => toast.classList.remove("is-visible"), 2200);
      };

      const revealItems = document.querySelectorAll("[data-reveal]");
      if ("IntersectionObserver" in window && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-revealed");
              observer.unobserve(entry.target);
            }
          });
        }, { rootMargin: "0px 0px -48px" });
        revealItems.forEach((item) => observer.observe(item));
      } else {
        revealItems.forEach((item) => item.classList.add("is-revealed"));
      }

      document.querySelectorAll("[data-waitlist-form]").forEach((form) => {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          const button = form.querySelector("button");
          const status = form.querySelector("[data-form-status]");
          button.disabled = true;
          button.textContent = "TRANSMITTING…";
          try {
            const response = await fetch("/api/waitlist", {
              method: "POST",
              headers: { "content-type": "application/json" },
              body: JSON.stringify(Object.fromEntries(new FormData(form)))
            });
            const data = await response.json();
            if (!response.ok) throw new Error(data.message || "Could not join");
            status.textContent = data.added
              ? "Signal received. You’re on the list."
              : "You’re already in the system.";
            form.reset();
          } catch (error) {
            status.textContent = error.message || "Signal lost. Try again.";
          } finally {
            button.disabled = false;
            button.textContent = "JOIN WAITLIST ↗";
          }
        });
      });
    </script>
  </body>
</html>
